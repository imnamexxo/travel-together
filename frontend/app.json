{
  "expo": {
    "name": "Travel Together",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "traveltogether",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#223858",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kang1031.frontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 앨범에 추가할 사진을 선택합니다.",
          "cameraPermission": "영수증을 찍어 지출 초안을 만듭니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#223858",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69693ebb-31d1-4aa4-8ccb-2b68a0429fde"
      }
    },
    "owner": "kang1031",
    "updates": {
      "url": "https://u.expo.dev/69693ebb-31d1-4aa4-8ccb-2b68a0429fde"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}

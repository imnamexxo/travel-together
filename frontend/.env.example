# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# EXPO_PUBLIC_ 값은 앱에 그대로 들어가므로 비밀 키를 넣지 않는다.

# 서버 주소 (Render 배포 주소, 또는 같은 와이파이의 PC 주소 http://<PC IP>:8000)
EXPO_PUBLIC_API_URL=

# Supabase 프로젝트 URL과 publishable(anon) 키. 로그인에만 쓴다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 구글 지도 Android 키(#16). 앱 설정(app.config.js)에만 들어가고 JS 코드에는 들어가지 않는다.
# EAS 빌드에서는 expo.dev → 프로젝트 → Environment variables에 같은 이름으로 넣는다.
GOOGLE_MAPS_ANDROID_KEY=

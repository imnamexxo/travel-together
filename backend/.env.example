# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 로컬 개발·테스트용 PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/divided_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/divided_test

# Supabase (#3)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# 카카오 로컬 API (#7)
KAKAO_REST_API_KEY=

# Gemini (#8)
GEMINI_API_KEY=
